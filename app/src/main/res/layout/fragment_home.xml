<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Card.Match"
    android:background="#E6ECF4">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/shopScrollLayer"
        style="@style/Widget.Card.Match"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            style="@style/Widget.Card.MatchWrap"
            android:orientation="vertical">

            <include
                android:id="@+id/homeAppBar"
                layout="@layout/layout_home_appbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                style="@style/Widget.Card.MatchWrap"
                android:gravity="center"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:background="@color/white"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/margin_medium"
                        android:layout_weight="2"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/margin_extra_small"
                            android:letterSpacing="0.1"
                            android:text="Delivery to"
                            android:textColor="@color/text_dark_300"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_extra_small"
                            android:letterSpacing="0.1"
                            android:maxLines="1"
                            android:text="Add address for place order!"
                            android:textColor="@color/text_dark_400"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.3" />

                    <TextView
                        android:id="@+id/setAddressBtn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.3"
                        android:clickable="true"
                        android:focusable="true"
                        android:letterSpacing="0.1"
                        android:maxLines="1"
                        android:padding="@dimen/padding_medium"
                        android:text="SET ADDRESS"
                        android:textAlignment="center"
                        android:textColor="@color/green"
                        android:textSize="14sp" />

                </LinearLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    style="@style/Widget.Card.MatchWrap"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="16dp">

                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/vpBanner"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:minHeight="160dp"
                        android:orientation="horizontal"
                        android:scrollbars="none"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintDimensionRatio="2:1"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tabLayoutIndicator"
                    style="@style/Widget.Card.Wrap"
                    android:layout_height="8dp"
                    android:layout_marginTop="12dp"
                    android:background="@android:color/transparent"
                    app:tabBackground="@drawable/tab_selector"
                    app:tabGravity="center"
                    app:tabIndicatorHeight="0dp"
                    app:tabPaddingEnd="5dp"
                    app:tabPaddingStart="5dp" />

            </LinearLayout>

            <LinearLayout
                style="@style/Widget.Card.MatchWrap"
                android:layout_marginHorizontal="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Widget.Card.Wrap"
                    android:text="@string/categories"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Space style="@style/Widget.Card.layout_weight" />

                <ImageView
                    style="@style/Widget.Card.Wrap"
                    android:background="@drawable/transparent_background"
                    android:minWidth="46dp"
                    android:minHeight="24dp"
                    android:src="@drawable/ic_arrow_right" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/categoryRecyclerView"
                style="@style/Widget.Card.Wrap"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:minHeight="85dp"
                android:orientation="horizontal"
                android:scrollbars="none"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <LinearLayout
                style="@style/Widget.Card.MatchWrap"
                android:layout_marginHorizontal="16dp"
                android:layout_marginVertical="@dimen/margin_medium"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Widget.Card.Wrap"
                    android:text="@string/featured"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Space style="@style/Widget.Card.layout_weight" />

                <ImageView
                    android:id="@+id/featuredProductBtn"
                    style="@style/Widget.Card.Wrap"
                    android:background="@drawable/transparent_background"
                    android:minWidth="46dp"
                    android:minHeight="24dp"
                    android:src="@drawable/ic_arrow_right" />

            </LinearLayout>

            <include
                android:id="@+id/featuredTryAgain"
                layout="@layout/layout_retry"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFeaturedProduct"
                style="@style/Widget.Card.Match"
                android:layout_marginStart="@dimen/margin_medium" />

            <LinearLayout
                style="@style/Widget.Card.MatchWrap"
                android:layout_marginHorizontal="16dp"
                android:layout_marginVertical="@dimen/margin_medium"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Widget.Card.Wrap"
                    android:text="@string/hot_deal"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Space style="@style/Widget.Card.layout_weight" />

                <ImageView
                    android:id="@+id/hotDealProductsBtn"
                    style="@style/Widget.Card.Wrap"
                    android:background="@drawable/transparent_background"
                    android:minWidth="46dp"
                    android:minHeight="24dp"
                    android:src="@drawable/ic_arrow_right" />

            </LinearLayout>

            <include
                android:id="@+id/hotDealsTryAgain"
                layout="@layout/layout_retry"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvHotDealProduct"
                style="@style/Widget.Card.Match"
                android:layout_marginStart="@dimen/margin_medium" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                android:layout_margin="@dimen/margin_medium"
                app:cardBackgroundColor="@android:color/transparent">

                <ImageView
                    style="@style/Widget.Card.Match"
                    android:scaleType="centerCrop"
                    android:src="@drawable/benchmark" />

            </androidx.cardview.widget.CardView>

            <LinearLayout
                style="@style/Widget.Card.MatchWrap"
                android:layout_marginStart="@dimen/margin_medium"
                android:layout_marginTop="@dimen/margin_medium"
                android:orientation="horizontal">

                <TextView
                    style="@style/Widget.Card.Wrap"
                    android:text="Most Popular"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <include
                android:id="@+id/mostPopularTryAgain"
                layout="@layout/layout_retry"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/hotDealCategoriesRecyclerView"
                style="@style/Widget.Card.MatchWrap"
                android:layout_marginHorizontal="16dp" />

            <LinearLayout
                style="@style/Widget.Card.MatchWrap"
                android:layout_marginHorizontal="16dp"
                android:layout_marginVertical="@dimen/margin_medium"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Widget.Card.Wrap"
                    android:text="@string/popular"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Space style="@style/Widget.Card.layout_weight" />

                <ImageView
                    android:id="@+id/popularBrandBtn"
                    style="@style/Widget.Card.Wrap"
                    android:background="@drawable/transparent_background"
                    android:minWidth="46dp"
                    android:minHeight="24dp"
                    android:src="@drawable/ic_arrow_right" />

            </LinearLayout>

            <include
                android:id="@+id/popularBrandTryAgain"
                layout="@layout/layout_retry"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPopularBrand"
                style="@style/Widget.Card.Match"
                android:layout_marginStart="@dimen/margin_medium" />

            <LinearLayout
                style="@style/Widget.Card.MatchWrap"
                android:layout_marginHorizontal="16dp"
                android:layout_marginVertical="@dimen/margin_medium"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Widget.Card.Wrap"
                    android:text="@string/recommended"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Space style="@style/Widget.Card.layout_weight" />

                <ImageView
                    style="@style/Widget.Card.Wrap"
                    android:background="@drawable/transparent_background"
                    android:minWidth="46dp"
                    android:minHeight="24dp"
                    android:src="@drawable/ic_arrow_right" />

            </LinearLayout>

            <include
                android:id="@+id/recommendedTryAgain"
                layout="@layout/layout_retry"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRecommended"
                style="@style/Widget.Card.MatchWrap"
                android:layout_marginStart="@dimen/margin_medium"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:visibility="gone"
        android:id="@+id/floatingSellButton"
        style="@style/Widget.Card.Wrap"
        android:layout_marginEnd="@dimen/margin_medium"
        android:layout_marginBottom="@dimen/margin_large"
        android:background="@drawable/bg_sell"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            style="@style/Widget.Card.Wrap"
            android:layout_marginVertical="12dp"
            android:layout_marginStart="16dp"
            android:minWidth="24dp"
            android:minHeight="24dp"
            android:src="@drawable/ic_sell" />

        <TextView
            android:id="@+id/floatingSell"
            style="@style/Widget.Card.Wrap"
            android:layout_marginEnd="16dp"
            android:gravity="center"
            android:letterSpacing="0.1"
            android:maxLines="1"
            android:paddingStart="6dp"
            android:text="@string/sell_btn"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>