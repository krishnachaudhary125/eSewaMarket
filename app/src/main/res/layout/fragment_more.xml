<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#E6ECF4">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            style="@style/Widget.Card.MatchWrap"
            android:orientation="vertical">

            <include
                android:id="@+id/toolbarMore"
                style="@style/Widget.Card.MatchWrap"
                layout="@layout/toolbar_back_title_action" />

    <!-- Start of profile -->

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_medium"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

        <!-- Profile Top -->

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:visibility="gone"
                        android:id="@+id/profileLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <androidx.cardview.widget.CardView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_marginStart="16dp"
                            android:layout_marginTop="16dp"
                            app:cardElevation="0dp"
                            app:cardCornerRadius="16dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <ImageView
                                android:id="@+id/userProfile"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"/>

                        </androidx.cardview.widget.CardView>

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="61dp"
                            android:layout_marginStart="61dp"
                            android:src="@drawable/ic_verified"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent"/>

                        <TextView
                            android:id="@+id/userName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="80dp"
                            android:layout_marginTop="23dp"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/userPhone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="80dp"
                            android:layout_marginTop="47dp"
                            android:textSize="14sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="16dp"
                            android:layout_marginTop="16dp"
                            android:letterSpacing="0.2"
                            android:text="VIEW PROFILE"
                            android:textColor="@color/green"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <LinearLayout
                        android:visibility="gone"
                        android:id="@+id/underline"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginTop="19dp"
                        android:orientation="vertical"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="16dp"
                            android:orientation="vertical">

                            <LinearLayout
                                android:visibility="gone"
                                android:id="@+id/myProfileAndMyOrder"
                                style="@style/Widget.Card.MatchWrap"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textStyle="bold"
                                    android:textSize="14sp"
                                    android:paddingTop="8dp"
                                    android:paddingBottom="8dp"
                                    android:text="My Profile"/>

                                <LinearLayout
                                    android:gravity="center"
                                    android:layout_width="match_parent"
                                    android:layout_marginTop="8dp"
                                    android:layout_height="36dp"
                                    android:orientation="horizontal">

                                    <ImageView
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:layout_marginEnd="8dp"
                                        android:src="@drawable/ic_my_products"/>

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="8dp"
                                        android:textSize="14sp"
                                        android:text="My Products"/>

                                    <Space style="@style/Widget.Card.layout_weight"/>

                                    <TextView
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:gravity="center"
                                        android:background="@drawable/bg_green_circle"
                                        android:textColor="@color/white"
                                        android:text="2"/>
                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/shippingAddress"
                                    android:gravity="center"
                                    android:layout_width="match_parent"
                                    android:layout_marginTop="8dp"
                                    android:layout_height="36dp"
                                    android:clickable="true"
                                    android:orientation="horizontal">

                                    <ImageView
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:layout_marginEnd="8dp"
                                        android:src="@drawable/ic_shippping_address"/>

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="8dp"
                                        android:textSize="14sp"
                                        android:text="Shipping Address"/>

                                    <Space style="@style/Widget.Card.layout_weight"/>

                                </LinearLayout>

                                <LinearLayout
                                    android:background="#E6ECF4"
                                    android:layout_width="match_parent"
                                    android:layout_height="1dp"
                                    android:layout_marginStart="16dp"
                                    android:layout_marginEnd="16dp"
                                    android:layout_marginTop="16dp"
                                    android:layout_marginBottom="16dp"
                                    android:orientation="horizontal"/>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textStyle="bold"
                                        android:textSize="14sp"
                                        android:paddingTop="8dp"
                                        android:paddingBottom="8dp"
                                        android:text="My Order"/>

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="36dp"
                                        android:layout_marginTop="8dp"
                                        android:gravity="center"
                                        android:orientation="horizontal">

                                        <ImageView
                                            android:layout_width="24dp"
                                            android:layout_height="24dp"
                                            android:layout_marginEnd="8dp"
                                            android:src="@drawable/ic_my_products"/>

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="8dp"
                                            android:text="My Order"/>

                                        <Space style="@style/Widget.Card.layout_weight"/>

                                        <TextView
                                            android:layout_width="20dp"
                                            android:layout_height="20dp"
                                            android:gravity="center"
                                            android:background="@drawable/bg_green_circle"
                                            android:textColor="@color/white"
                                            android:text="2"/>

                                    </LinearLayout>

                                    <LinearLayout
                                        android:id="@+id/myReturn"
                                        android:layout_width="match_parent"
                                        android:layout_height="36dp"
                                        android:layout_marginTop="8dp"
                                        android:clickable="true"
                                        android:gravity="center">

                                        <ImageView
                                            android:layout_width="24dp"
                                            android:layout_height="24dp"
                                            android:layout_marginEnd="8dp"
                                            android:src="@drawable/ic_return"/>

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="8dp"
                                            android:text="My Return"/>

                                        <Space style="@style/Widget.Card.layout_weight"/>

                                    </LinearLayout>

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="36dp"
                                        android:layout_marginTop="8dp"
                                        android:gravity="center">

                                        <ImageView
                                            android:layout_width="24dp"
                                            android:layout_height="24dp"
                                            android:layout_marginEnd="8dp"
                                            android:src="@drawable/ic_cancellation"/>

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="8dp"
                                            android:text="My Cancellation"/>

                                        <Space style="@style/Widget.Card.layout_weight"/>

                                    </LinearLayout>

                                </LinearLayout>
                            </LinearLayout>

                            <LinearLayout
                                android:visibility="visible"
                                android:id="@+id/userLogin"
                                android:layout_marginTop="@dimen/margin_large"
                                style="@style/Widget.Card.MatchWrap"
                                android:gravity="center"
                                android:orientation="vertical">

                                <LinearLayout
                                    style="@style/Widget.Card.MatchWrap"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/login"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:textStyle="bold"
                                        android:textSize="16sp"
                                        android:layout_marginEnd="@dimen/margin_small"
                                        android:layout_weight="1"
                                        android:clickable="true"
                                        android:focusable="true"
                                        android:gravity="center"
                                        android:paddingVertical="@dimen/padding_medium"
                                        android:paddingHorizontal="@dimen/padding_large"
                                        android:textColor="@color/white"
                                        android:background="@drawable/bg_continue_shopping"
                                        android:text="Login"/>

                                    <TextView
                                        android:id="@+id/register"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:textStyle="bold"
                                        android:textSize="16sp"
                                        android:layout_marginStart="@dimen/margin_small"
                                        android:layout_weight="1"
                                        android:clickable="true"
                                        android:focusable="true"
                                        android:gravity="center"
                                        android:paddingVertical="@dimen/padding_medium"
                                        android:paddingHorizontal="@dimen/padding_large"
                                        android:textColor="@color/white"
                                        android:background="@drawable/bg_continue_shopping"
                                        android:text="Register"/>

                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/signInWithGoogle"
                                    style="@style/Widget.Card.Wrap"
                                    android:layout_marginTop="@dimen/margin_medium"
                                    android:orientation="horizontal"
                                    android:background="@drawable/bg_sign_in_with_google"
                                    android:gravity="center"
                                    android:layout_gravity="center">

                                    <ImageView
                                        style="@style/Widget.Card.Wrap"
                                        android:padding="@dimen/padding_medium"
                                        android:src="@drawable/ic_google"/>

                                    <TextView
                                        style="@style/Widget.Card.Wrap"
                                        android:textSize="16sp"
                                        android:paddingEnd="@dimen/padding_medium"
                                        android:textStyle="bold"
                                        android:textColor="@color/text_dark_200"
                                        android:text="Sign in with Google"/>

                                </LinearLayout>

                            </LinearLayout>

                            <LinearLayout
                                android:background="#E6ECF4"
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginStart="16dp"
                                android:layout_marginEnd="16dp"
                                android:layout_marginTop="16dp"
                                android:layout_marginBottom="16dp"
                                android:orientation="horizontal"/>


                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textStyle="bold"
                                    android:textSize="14sp"
                                    android:paddingTop="8dp"
                                    android:paddingBottom="8dp"
                                    android:text="Reward and Promotions"/>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="36dp"
                                    android:layout_marginTop="8dp"
                                    android:gravity="center"
                                    android:orientation="horizontal">

                                    <ImageView
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:layout_marginEnd="8dp"
                                        android:src="@drawable/ic_reward"/>

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="8dp"
                                        android:text="Rewards Points"/>

                                    <Space style="@style/Widget.Card.layout_weight"/>

                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="36dp"
                                    android:layout_marginTop="8dp"
                                    android:gravity="center"
                                    android:orientation="horizontal">

                                    <ImageView
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:layout_marginEnd="8dp"
                                        android:src="@drawable/ic_promocode"/>

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="8dp"
                                        android:text="Apply Promocode"/>

                                    <Space style="@style/Widget.Card.layout_weight"/>

                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="36dp"
                                    android:layout_marginTop="8dp"
                                    android:gravity="center"
                                    android:orientation="horizontal">

                                    <ImageView
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:layout_marginEnd="8dp"
                                        android:src="@drawable/ic_bonus"/>

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="8dp"
                                        android:text="Daily Buy Bonus"/>

                                    <Space style="@style/Widget.Card.layout_weight"/>

                                </LinearLayout>

                            </LinearLayout>

                            <LinearLayout
                                android:background="#E6ECF4"
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginStart="16dp"
                                android:layout_marginEnd="16dp"
                                android:layout_marginTop="16dp"
                                android:layout_marginBottom="16dp"
                                android:orientation="horizontal"/>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textStyle="bold"
                                    android:textSize="14sp"
                                    android:paddingTop="8dp"
                                    android:paddingBottom="8dp"
                                    android:text="Help"/>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="20dp"
                                        android:layout_marginBottom="16dp"
                                        android:text="About Us"/>

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="20dp"
                                        android:layout_marginBottom="16dp"
                                        android:text="Customer Support"/>

                                    <TextView
                                        android:id="@+id/faq"
                                        android:clickable="true"
                                        android:layout_width="wrap_content"
                                        android:layout_height="20dp"
                                        android:text="FAQs"/>

                                </LinearLayout>

                            </LinearLayout>

                            <LinearLayout
                                android:background="#E6ECF4"
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginStart="16dp"
                                android:layout_marginEnd="16dp"
                                android:layout_marginTop="16dp"
                                android:layout_marginBottom="16dp"
                                android:orientation="horizontal"/>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textStyle="bold"
                                    android:textSize="14sp"
                                    android:paddingTop="8dp"
                                    android:paddingBottom="8dp"
                                    android:text="Legal Terms"/>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/margin_small"
                                    android:layout_marginBottom="@dimen/margin_medium"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="20dp"
                                        android:layout_marginBottom="16dp"
                                        android:text="Terms and Conditions"/>

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="20dp"
                                        android:layout_marginBottom="16dp"
                                        android:text="Privacy Policies"/>

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="20dp"
                                        android:text="All Legal Policies"/>

                                </LinearLayout>

                            </LinearLayout>

                            <TextView
                                android:visibility="gone"
                                android:id="@+id/logoutBtn"
                                style="@style/Widget.Card.MatchWrap"
                                android:textColor="@color/white"
                                android:textStyle="bold"
                                android:clickable="true"
                                android:focusable="true"
                                android:letterSpacing="0.05"
                                android:layout_marginVertical="@dimen/margin_large"
                                android:paddingVertical="@dimen/padding_medium"
                                android:gravity="center"
                                android:textSize="16sp"
                                android:background="@drawable/bg_continue_shopping"
                                android:text="Log Out"/>

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:letterSpacing="0.2"
                android:textColor="#8E90A6"
                android:layout_marginBottom="128dp"
                android:text="VERSION 1.0.0"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#66000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:elevation="4dp">

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminateTint="@color/green"
            android:layout_gravity="center"/>

        <TextView
            android:id="@+id/registerCancelBtn"
            style="@style/Widget.Card.Wrap"
            android:text="Cancel"
            android:paddingVertical="@dimen/padding_small"
            android:paddingHorizontal="@dimen/padding_large"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:background="@drawable/bg_continue_shopping"
            android:layout_marginTop="50dp"
            android:layout_gravity="center"/>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>