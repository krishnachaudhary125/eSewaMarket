<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#E6ECF4">

    <ImageView
        android:id="@+id/esewaLogo"
        style="@style/Widget.Card.Wrap"
        android:layout_marginTop="@dimen/margin_large"
        android:paddingVertical="@dimen/padding_medium"
        android:src="@drawable/logo_esewa_tm"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tvWelcome"
        style="@style/Widget.Card.Wrap"
        android:textSize="16sp"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        android:paddingVertical="@dimen/padding_small"
        android:layout_marginTop="@dimen/margin_medium"
        app:layout_constraintTop_toBottomOf="@id/esewaLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:text="Welcome Back!"/>

    <TextView
        android:id="@+id/tvText"
        style="@style/Widget.Card.Wrap"
        android:textSize="12sp"
        android:textColor="@color/below_welcome"
        android:paddingVertical="@dimen/padding_extra_small"
        app:layout_constraintTop_toBottomOf="@id/tvWelcome"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:text="Your friendly local and global market companion"/>

    <androidx.cardview.widget.CardView
        style="@style/Widget.Card.MatchWrap"
        android:layout_marginHorizontal="@dimen/margin_extra_large"
        android:layout_marginTop="@dimen/margin_extreme_large"
        app:cardCornerRadius="16dp"
        app:cardBackgroundColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/tvText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            style="@style/Widget.Card.MatchWrap"
            android:layout_margin="@dimen/margin_large"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="4dp"
                    android:text="EMAIL OR PHONE NUMBER"
                    android:textColor="@color/text_dark"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/loginEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Enter your email or phone"
                        android:inputType="textEmailAddress"
                        android:letterSpacing="0.1"
                        android:minHeight="56dp"
                        android:background="@drawable/bg_faq_question" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_large"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="4dp"
                    android:text="PASSWORD"
                    android:textColor="@color/text_dark"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:endIconMode="password_toggle"
                    app:hintEnabled="false"
                    app:endIconTint="@color/text_dark_100">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Enter your password"
                        android:inputType="textPassword"
                        android:letterSpacing="0.1"
                        android:minHeight="56dp"
                        android:background="@drawable/bg_faq_question" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <LinearLayout
                style="@style/Widget.Card.MatchWrap"
                android:layout_marginTop="@dimen/margin_medium"
                android:orientation="horizontal">

                <Space style="@style/Widget.Card.layout_weight"/>

                <TextView
                    android:id="@+id/forgotPassword"
                    style="@style/Widget.Card.Wrap"
                    android:textSize="12sp"
                    android:letterSpacing="0.05"
                    android:clickable="true"
                    android:focusable="true"
                    android:textColor="@color/green"
                    android:text="Forgot Password?"/>

            </LinearLayout>

            <TextView
                android:id="@+id/loginBtn"
                style="@style/Widget.Card.MatchWrap"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginTop="@dimen/padding_large"
                android:paddingVertical="@dimen/padding_medium"
                android:background="@drawable/bg_continue_shopping"
                android:text="Login"/>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <LinearLayout
        style="@style/Widget.Card.Wrap"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.05"
            android:text="Don't have an account? "
            android:textColor="@color/text_dark"
            android:textSize="14sp"
            android:textStyle="normal" />

        <TextView
            android:id="@+id/redirectToRegister"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.05"
            android:paddingVertical="@dimen/padding_medium"
            android:text="Sign Up"
            android:clickable="true"
            android:focusable="true"
            android:textColor="@color/green"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#66000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:elevation="4dp">

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminateTint="@color/green"
            android:layout_gravity="center"/>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>