<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E6ECF4"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <include
        android:id="@+id/toolbarShippingAddress"
        layout="@layout/toolbar_back_title"
        style="@style/Widget.Card.MatchWrap"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/addressBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:paddingBottom="72dp"
        android:background="#ffffff"
        app:layout_constraintTop_toBottomOf="@id/toolbarShippingAddress"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/noAddressIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="132dp"
            android:minWidth="145dp"
            android:src="@drawable/ic_no_address"
            android:layout_marginTop="48dp"
            android:padding="64dp"
            android:background="@drawable/bg_return"
            app:layout_constraintTop_toTopOf="@id/addressBox"
            app:layout_constraintStart_toStartOf="@id/addressBox"
            app:layout_constraintEnd_toEndOf="@id/addressBox"/>

        <LinearLayout
            android:id="@+id/noAddressText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/noAddressIcon"
            app:layout_constraintStart_toStartOf="@id/addressBox"
            app:layout_constraintEnd_toEndOf="@id/addressBox">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textStyle="bold"
                android:text="No address added yet!"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="4dp"
                android:textSize="16sp"
                android:textColor="#8E90A6"
                android:text="You have not added any shipping \naddress yet."/>

        </LinearLayout>

        <TextView
            android:id="@+id/addAddressNow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_continue_shopping"
            android:text="ADD ADDRESS NOW"
            android:clickable="true"
            android:textSize="14sp"
            android:paddingVertical="12dp"
            android:paddingHorizontal="16dp"
            android:letterSpacing="0.15"
            app:layout_constraintTop_toBottomOf="@id/noAddressText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>