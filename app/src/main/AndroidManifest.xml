<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    // Internet Permission
    <uses-permission android:name="android.permission.INTERNET"/>

    // Location Permission
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:name=".EsewaMarketApplication"
        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_esewa"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_esewa_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Try">

        // Google Map API
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <activity
            android:name="com.example.eSewaMarket.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.App.SplashScreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".FaqActivity"/>
        <activity android:name=".NotificationActivity"/>
        <activity android:name=".MyReturnActivity"/>
        <activity android:name=".ShippingAddressActivity"/>
        <activity android:name=".NewAddressActivity"/>
        <activity android:name=".PostProductActivity"/>
        <activity android:name=".ProductDetailActivity"/>
        <activity android:name=".LoginActivity"/>
        <activity android:name=".RegisterActivity"/>
        <activity android:name=".FeaturedProductActivity"/>
        <activity android:name=".CheckoutActivity"/>
        <activity android:name=".HotDealProductsActivity"/>
        <activity android:name=".PopularBrandActivity"/>
        <activity android:name=".EmailVerificationActivity"/>
        <activity android:name=".MapActivity"/>
    </application>

</manifest>